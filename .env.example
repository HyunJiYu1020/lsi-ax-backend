# Postgres 접속 문자열. `docker compose up db`로 띄운 로컬 DB 기준값.
DATABASE_URL=postgresql+psycopg://slsi:slsi@localhost:5432/slsi
# 운영 배포용 CORS 화이트리스트(JSON 배열). 로컬 개발 중엔 app/main.py의
# allow_origin_regex(localhost/127.0.0.1 전 포트 허용)가 대신 처리하므로 사실상 미사용.
CORS_ORIGINS=["http://localhost:5173"]
# 플로팅 AI 채팅(/api/v1/chat) 공급자: anthropic(기본, 유료, 키 필요) | ollama(로컬, 무료, 키 불필요)
CHAT_PROVIDER=anthropic
# anthropic 쓸 때만 필요. https://console.anthropic.com 에서 발급.
ANTHROPIC_API_KEY=
# anthropic 쓸 때 사용할 모델명.
ANTHROPIC_MODEL=claude-sonnet-5
# ollama 쓸 때만 필요(기본값이면 생략 가능).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b

# MCP 서버(app/mcp_server.py)가 호출할 백엔드 API 베이스.
# 이 .env 파일로는 안 읽히고(mcp_server.py가 os.environ에서 직접 읽음), .mcp.json의
# env 블록이나 셸 환경변수로 넘겨야 한다. 참고용으로만 적어둠. 자세한 내용은 CONNECTIONS.md 참고.
# SLSI_API_BASE=http://localhost:8000/api/v1
