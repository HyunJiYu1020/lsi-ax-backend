# Postgres 접속 문자열. `docker compose up db`로 띄운 로컬 DB 기준값.
DATABASE_URL=postgresql+psycopg://slsi:slsi@localhost:5432/slsi
# 운영 배포용 CORS 화이트리스트(JSON 배열). 로컬 개발 중엔 app/main.py의
# allow_origin_regex(localhost/127.0.0.1 전 포트 허용)가 대신 처리하므로 사실상 미사용.
CORS_ORIGINS=["http://localhost:5173"]
# 플로팅 AI 채팅(/api/v1/chat) 공급자: anthropic(유료, 키 필요) | ollama(로컬, 무료, 키 불필요) | gemini(유료, 키 필요)
CHAT_PROVIDER=gemini
# anthropic 쓸 때만 필요. https://console.anthropic.com 에서 발급.
ANTHROPIC_API_KEY=
# anthropic 쓸 때 사용할 모델명.
ANTHROPIC_MODEL=claude-sonnet-5
# ollama 쓸 때만 필요(기본값이면 생략 가능).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b
# gemini 쓸 때만 필요. https://aistudio.google.com/apikey 에서 발급.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 업로드 원본 파일(엑셀) 보존용 S3. 버킷 전용 IAM 사용자 키를 쓰고, 권한은 그 버킷에 대한
# s3:PutObject/s3:GetObject로 최소화할 것. 비워두면(기본값) 업로드 기능은 S3 저장만 건너뛰고
# 나머지(파일명·파싱 결과 저장)는 그대로 동작한다 — 버킷 준비 전에도 앱이 깨지지 않는다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_UPLOAD_BUCKET=

# MCP 서버(app/mcp_server.py)가 호출할 백엔드 API 베이스.
# 이 .env 파일로는 안 읽히고(mcp_server.py가 os.environ에서 직접 읽음), .mcp.json의
# env 블록이나 셸 환경변수로 넘겨야 한다. 참고용으로만 적어둠. 자세한 내용은 CONNECTIONS.md 참고.
# SLSI_API_BASE=http://localhost:8000/api/v1
